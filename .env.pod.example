SPRING_PROFILES_ACTIVE=pod

# --- Discovery & Security ---
EUREKA_DEFAULT_ZONE=http://eureka:8761/eureka/
JWT_ISSUER_URI=http://localhost:8080
JWT_JWK_SET_URI=http://userservice:8081/.well-known/jwks.json
OTP_CHALLENGE_SECRET=student-local-secret-key-32chars-min-length-12345
AUTH_EXPOSE_OTP=true

# --- Frontend CORS & Websocket ---
ADMIN_FE_ORIGIN=http://localhost:5173
MOBILE_FE_ORIGIN=http://localhost:8088
WS_ALLOWED_ORIGINS=http://localhost:8088
GATEWAY_PORT=8080

# --- MinIO Object Storage ---
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# QUAN TRỌNG: Phải là IP hoặc domain mà client bên ngoài (mobile, browser) có thể truy cập.
# KHÔNG dùng localhost — client bên ngoài sẽ không reach được MinIO qua localhost.
# Ví dụ: STORAGE_PUBLIC_ENDPOINT=http://192.168.1.100:9000
STORAGE_PUBLIC_ENDPOINT=http://<SERVER_IP_OR_DOMAIN>:9000

# --- RabbitMQ Broker ---
RABBITMQ_USERNAME=driverapp
RABBITMQ_PASSWORD=driverapp123

# --- PostgreSQL (Chạy trực tiếp trong Docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
USER_DB_URL=jdbc:postgresql://postgres:5432/driverapp_user_db
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=postgres123

DRIVER_DB_URL=jdbc:postgresql://postgres:5432/driverapp_driver_db
DRIVER_DB_USERNAME=postgres
DRIVER_DB_PASSWORD=postgres123

FEEDBACK_DB_URL=jdbc:postgresql://postgres:5432/driverapp_feedback_db
FEEDBACK_DB_USERNAME=postgres
FEEDBACK_DB_PASSWORD=postgres123

NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/driverapp_notification_db
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=postgres123

# --- MongoDB (Chạy trực tiếp trong Docker) ---
BOOKING_MONGODB_URI=mongodb://mongodb:27017/driverapp_booking_db
PAYMENT_MONGODB_URI=mongodb://mongodb:27017/driverapp_payment_db

# --- Optional Routing ---
OSRM_URL=http://osrm:5000
