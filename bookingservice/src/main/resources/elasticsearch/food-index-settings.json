{
  "analysis": {
    "filter": {
      "edge_ngram_filter": {
        "type": "edge_ngram",
        "min_gram": 2,
        "max_gram": 15
      },
      "vietnamese_ascii_folding": {
        "type": "asciifolding",
        "preserve_original": true
      }
    },
    "analyzer": {
      "autocomplete_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "vietnamese_ascii_folding", "edge_ngram_filter"]
      },
      "search_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "vietnamese_ascii_folding"]
      }
    }
  }
}
