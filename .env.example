SPRING_PROFILES_ACTIVE=dev
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
JWT_ISSUER_URI=http://localhost:8081
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
ADMIN_FE_ORIGIN=http://localhost:5173
MOBILE_FE_ORIGIN=http://localhost:8088
WS_ALLOWED_ORIGINS=http://localhost:8088
# QUAN TRỌNG: Phải là IP hoặc domain mà client bên ngoài (mobile, browser) có thể truy cập.
# KHÔNG dùng localhost khi test từ điện thoại hoặc máy khác.
# Ví dụ: STORAGE_PUBLIC_ENDPOINT=http://192.168.1.100:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

RABBITMQ_USERNAME=driverapp
RABBITMQ_PASSWORD=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
OTP_CHALLENGE_SECRET=

# PostgreSQL and MongoDB are provisioned outside this Compose project.
USER_DB_URL=jdbc:postgresql://localhost:5432/driverapp_user_db
USER_DB_USERNAME=
USER_DB_PASSWORD=
DRIVER_DB_URL=jdbc:postgresql://localhost:5432/driverapp_driver_db
DRIVER_DB_USERNAME=
DRIVER_DB_PASSWORD=
FEEDBACK_DB_URL=jdbc:postgresql://localhost:5432/driverapp_feedback_db
FEEDBACK_DB_USERNAME=
FEEDBACK_DB_PASSWORD=
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/driverapp_notification_db
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
BOOKING_MONGODB_URI=mongodb://localhost:27017/driverapp_booking_db
PAYMENT_MONGODB_URI=mongodb://localhost:27017/driverapp_payment_db

# Enable explicitly for an isolated local OTP demo only.
AUTH_EXPOSE_OTP=false
